[Unit]
Description=Djiwa Pay payment-mail receiver (SMTP for catat.djiwapay.web.id)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/djiwapay-api
EnvironmentFile=/etc/djiwatentramapp/djiwapay-api.env
Environment=MAIL_PORT=25
Environment=MAIL_TLS_KEY=/etc/djiwapay-mail/privkey.pem
Environment=MAIL_TLS_CERT=/etc/djiwapay-mail/fullchain.pem
ExecStart=/usr/bin/node dist/mail.mjs
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/var/lib/djiwapay-api
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
