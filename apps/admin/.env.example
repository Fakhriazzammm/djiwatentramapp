# Supabase (Self-Hosted)
# Local dev: http://localhost:8099 (Kong proxy)
# Production via nginx: https://supabase.djiwatentram.web.id
VITE_SUPABASE_URL=https://supabase.djiwatentram.web.id
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
VITE_SUPABASE_STORAGE_BUCKET=app-assets

# Mayar Headless API (Payment Gateway)
	VITE_APP_BASE_URL=https://pos.djiwatentram.web.id
VITE_AUTH_URL=http://localhost:3000
VITE_ADMIN_APP_URL=https://admin.djiwatentram.web.id
VITE_POS_APP_URL=https://pos.djiwatentram.web.id
VITE_KARYAWAN_APP_URL=https://karyawan.djiwatentram.web.id
VITE_CUSTOMER_APP_URL=https://djiwatentram.web.id
VITE_API_BASE_URL=https://api.djiwatentram.web.id
VITE_PUBLIC_BOOKING_URL=https://booking.djiwatentram.web.id/

# ─── Onboarding Admin (Edge Function auth) ───────────────
# Secret untuk autentikasi ke Supabase Edge Function onboarding-admin.
# Harus sama dengan ONBOARDING_ADMIN_SECRET di Supabase secrets:
#   supabase secrets set ONBOARDING_ADMIN_SECRET=your-secret-here
VITE_ADMIN_SECRET=your-admin-secret-here
# Telegram Report Chat ID (opsional, override TELEGRAM_CHAT_ID di Supabase secrets)
# Grup Telegram: angka negatif, contoh: -1001234567890
# Tambahkan juga TELEGRAM_BOT_TOKEN dan TELEGRAM_CHAT_ID di:
#   Supabase Dashboard → Edge Functions → Manage secrets
VITE_TELEGRAM_REPORT_CHAT_ID=-1001234567890
