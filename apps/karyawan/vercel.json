{
  "buildCommand": "cd ../.. && bun run --cwd apps/karyawan build",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && bun install",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/:path((?!.*\\..*).*)", "destination": "/index.html" }
  ]
}
