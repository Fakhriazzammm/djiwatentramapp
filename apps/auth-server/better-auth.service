[Unit]
Description=Better Auth Server for Djiwa Tentram
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/djiwatentramapp/apps/auth-server
EnvironmentFile=/etc/djiwatentramapp/better-auth.env
ExecStart=/usr/local/bin/bun src/index.ts
Restart=always
RestartSec=5

Environment=BETTER_AUTH_URL=https://djiwatentram.yumme.id
Environment=BETTER_AUTH_PORT=3001




[Install]
WantedBy=multi-user.target
