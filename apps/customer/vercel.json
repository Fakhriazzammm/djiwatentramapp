{
  "buildCommand": "cd ../.. && bun run --cwd apps/customer build",
  "ignoreCommand": "bash ../../scripts/vercel-ignore.sh apps/customer packages/env supabase",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && bun install",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/:path*.(js|css|png|jpg|jpeg|webp|svg|gif|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/:path((?!.*\\..*).*)", "destination": "/index.html" }
  ]
}
