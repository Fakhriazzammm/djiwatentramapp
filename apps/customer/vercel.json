{
  "buildCommand": "cd ../.. && bun run --cwd apps/customer build",
  "ignoreCommand": "bash ../../scripts/vercel-ignore.sh apps/customer packages/env packages/yumipos-web-shared supabase",
  "outputDirectory": "dist",
  "installCommand": "cd ../.. && bun install",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/:path((?!.*\\..*).*)", "destination": "/index.html" }
  ]
}
