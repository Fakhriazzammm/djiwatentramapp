[Unit]
Description=Djiwa Tentram artifact auto-deploy (download CI artifact, verify, publish; never builds)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/djiwatentramapp/artifact-autodeploy.env
WorkingDirectory=/opt/djiwatentramapp
ExecStart=/usr/bin/flock -n /run/djiwa-artifact-deploy.lock /usr/bin/node /opt/djiwatentramapp/scripts/artifact-autodeploy.mjs
# Keep the box light: this must never compete with the apps.
Nice=19
IOSchedulingClass=idle
CPUWeight=10
MemoryMax=300M
TimeoutStartSec=600
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/djiwatentramapp /var/lib/djiwa-autodeploy
PrivateTmp=true
