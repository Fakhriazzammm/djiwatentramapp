{
  "appId": "id.web.djiwapay.app",
  "appName": "Djiwa Pay",
  "webDir": "www",
  "server": {
    "url": "https://djiwapay.web.id",
    "androidScheme": "https",
    "errorPath": "offline.html",
    "allowNavigation": ["djiwapay.web.id", "*.myr.id", "*.mayar.id", "*.mayar.club", "*.mayar.link"]
  },
  "android": { "allowMixedContent": false },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 1500, "launchAutoHide": false, "backgroundColor": "#f8f3e9", "showSpinner": false },
    "StatusBar": { "style": "LIGHT", "backgroundColor": "#f8f3e9", "overlaysWebView": false }
  }
}
