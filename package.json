{
  "name": "yumipos",
  "version": "0.2.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^3.24.1",
      "typescript": "5.0.4",
      "better-auth": "1.4.9",
      "vite": "^6.4.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:all": "concurrently \"turbo dev\" \"bun run ocr:dev\"",
    "build": "node scripts/update-version.mjs && turbo build",
    "build:pos": "node scripts/generate-pwa-manifest.mjs && turbo build --filter=@yumipos/pos",
    "build:customer": "node scripts/generate-pwa-manifest.mjs && turbo build --filter=@yumipos/customer",
    "build:karyawan": "node scripts/generate-pwa-manifest.mjs && turbo build --filter=@yumipos/karyawan",
    "build:web": "node scripts/generate-pwa-manifest.mjs && turbo build --filter=web",
    "build:admin": "node scripts/generate-pwa-manifest.mjs && turbo build --filter=@yumipos/admin",
    "build:merchandise": "node scripts/update-version.mjs && node scripts/write-version-manifest.mjs && turbo build --filter=@yumipos/merchandise",
    "build:b2b": "node scripts/update-version.mjs && node scripts/write-version-manifest.mjs && turbo build --filter=@yumipos/b2b",
    "dev:pos": "turbo dev --filter=@yumipos/pos",
    "dev:customer": "turbo dev --filter=@yumipos/customer",
    "dev:karyawan": "turbo dev --filter=@yumipos/karyawan",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @yumipos/backend dev",
    "dev:setup": "turbo -F @yumipos/backend dev:setup",
    "version": "node scripts/update-version.mjs",
    "ocr:dev": "cd packages/ocr-service && python main.py",
    "ocr:install": "cd packages/ocr-service && pip install -r requirements.txt"
  },
  "dependencies": {
    "@yumipos/env": "workspace:*",
    "dotenv": "^17.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@yumipos/config": "workspace:*",
    "turbo": "^2.7.6",
    "typescript": "5.0.4"
  },
  "packageManager": "bun@1.3.4"
}
