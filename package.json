{
  "name": "yumipos",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^3.24.1",
      "typescript": "^5",
      "convex": "^1.31.2",
      "better-auth": "1.4.9",
      "@convex-dev/better-auth": "^0.10.9",
      "vite": "^6.4.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:all": "concurrently \"turbo dev\" \"bun run ocr:dev\"",
    "build": "node scripts/update-version.mjs && turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @yumipos/backend dev",
    "dev:setup": "turbo -F @yumipos/backend dev:setup",
    "convex:push": "turbo -F @yumipos/backend push",
    "convex:pull": "turbo -F @yumipos/backend pull",
    "version": "node scripts/update-version.mjs",
    "ocr:dev": "cd packages/ocr-service && python main.py",
    "ocr:install": "cd packages/ocr-service && pip install -r requirements.txt"
  },
  "dependencies": {
    "@yumipos/env": "workspace:*",
    "convex": "^1.31.2",
    "dotenv": "^17.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "@yumipos/config": "workspace:*",
    "turbo": "^2.7.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.3.4"
}
