{
  "name": "tkmpos",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^3.24.1",
      "typescript": "^5",
      "convex": "^1.31.2",
      "better-auth": "1.4.9",
      "@convex-dev/better-auth": "^0.10.9",
      "vite": "^6.4.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @tkmpos/backend dev",
    "dev:setup": "turbo -F @tkmpos/backend dev:setup",
    "convex:push": "turbo -F @tkmpos/backend push",
    "convex:pull": "turbo -F @tkmpos/backend pull",
    "prepare": "husky"
  },
  "dependencies": {
    "@tkmpos/env": "workspace:*",
    "dotenv": "^17.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@tkmpos/config": "workspace:*",
    "@types/node": "^25.0.10",
    "husky": "latest",
    "lint-staged": "latest",
    "turbo": "^2.7.6",
    "typescript": "^5.9.3",
    "ultracite": "7.0.12"
  },
  "packageManager": "bun@1.3.4"
}
